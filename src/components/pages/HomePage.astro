---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Experience from '../sections/Experience.astro';
import Skills from '../sections/Skills.astro';
import Projects from '../sections/Projects.astro';
import Background from '../sections/Background.astro';
import Contact from '../sections/Contact.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <Hero lang={lang} />
  <Experience lang={lang} />
  <Skills lang={lang} />
  <Projects lang={lang} />
  <Background lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
