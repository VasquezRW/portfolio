---
import Section from '../ui/Section.astro';
import { getProfile } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { languages, education } = await getProfile(lang);
const CEFR = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'] as const;
---

<Section id="background" title={t('background.title')}>
  <div class="grid gap-10 md:grid-cols-2">
    <div>
      <h3 class="mb-4 text-subhead font-bold">{t('background.languages')}</h3>
      <ul class="space-y-6">
        {
          languages.map((l) => {
            const reached = l.level === 'native' ? CEFR.length - 1 : CEFR.indexOf(l.level);
            return (
              <li>
                <p class="font-bold">
                  {l.name}{' '}
                  <span class="font-medium text-muted">
                    · {l.level === 'native' ? t('background.native') : l.level}
                  </span>
                </p>
                <p class="text-[0.9375rem] text-muted">{l.description}</p>
                <ol
                  class="mt-3 grid grid-cols-6 gap-1"
                  aria-label={`CEFR: ${l.level === 'native' ? t('background.native') : l.level}`}
                >
                  {CEFR.map((level, i) => (
                    <li
                      class:list={[
                        'text-center text-small tabular-nums',
                        i === reached ? 'font-bold text-ink' : 'text-muted',
                      ]}
                    >
                      <span
                        aria-hidden="true"
                        class:list={[
                          'mb-1.5 block h-3.5 rounded-sm',
                          i <= reached ? 'bg-pine' : 'bg-line',
                        ]}
                      />
                      {level}
                    </li>
                  ))}
                </ol>
              </li>
            );
          })
        }
      </ul>
    </div>
    <div>
      <h3 class="mb-4 text-subhead font-bold">{t('background.education')}</h3>
      <ul>
        {
          education.map((e) => (
            <li class="border-t border-line py-4 first:border-t-0 first:pt-0">
              <p class="font-bold">{e.title}</p>
              <p class="text-[0.9375rem]">
                {e.institution} <span class="whitespace-nowrap text-muted">· {e.period}</span>
              </p>
              {e.note && <p class="text-[0.9375rem] text-muted">{e.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
