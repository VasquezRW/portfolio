---
import { getProfile } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { contact, availability } = await getProfile(lang);
const NAMES = { email: 'Email', github: 'GitHub', linkedin: 'LinkedIn', website: 'Web' } as const;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="border-y border-line bg-surface gutter band"
>
  <div class="mx-auto grid max-w-page gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <div>
      <h2 id="contact-title" class="mb-2 text-heading font-bold">{t('contact.title')}</h2>
      <p class="max-w-[52ch] text-lede text-muted">{t('contact.lede')}</p>
      <p class="mt-3 font-semibold text-ochre">{availability}</p>
    </div>
    <ul>
      {
        contact.map((c) => (
          <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 border-t border-line py-3.5">
            <span class="text-muted">{NAMES[c.kind]}</span>
            <a
              href={c.url}
              class="[overflow-wrap:anywhere]"
              rel={c.kind === 'email' ? undefined : 'me noopener'}
            >
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
