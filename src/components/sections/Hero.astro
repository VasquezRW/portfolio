---
import CareerGraph from './CareerGraph.astro';
import { getExperience, getProfile, getProjects } from '../../lib/content';
import { formatYearMonth } from '../../lib/dates';
import { dateLocale, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile(lang);
const jobs = await getExperience(lang);
const projects = await getProjects(lang);
const locale = dateLocale[lang];

const graphJobs = jobs.map((j) => ({
  id: j.id,
  company: j.data.company,
  role: j.data.role,
  start: j.data.start,
  end: j.data.end,
  commits: j.data.highlights.map((h) => h.title),
}));
const summary = [...jobs]
  .reverse()
  .map(
    (j) =>
      `${j.data.role}, ${j.data.company} (${formatYearMonth(j.data.start, locale)} – ${
        j.data.end ? formatYearMonth(j.data.end, locale) : t('experience.present')
      })`,
  )
  .join('; ');
---

<section class="gutter band" aria-labelledby="hero-title">
  <div class="mx-auto max-w-page">
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <div>
        <h1 id="hero-title" class="text-display font-extrabold">{profile.name}</h1>
        <p class="mt-2 mb-4 max-w-[36ch] text-subhead font-semibold text-pine">
          {profile.headline}
        </p>
        <p class="max-w-[62ch] text-lede text-muted">{profile.bio}</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a
            href="#projects"
            class="inline-flex min-h-11 items-center rounded-md border border-pine bg-pine px-4.5 font-semibold text-bg no-underline"
          >
            {t('hero.ctaProjects')}
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center rounded-md border border-pine px-4.5 font-semibold no-underline"
          >
            {t('hero.ctaContact')}
          </a>
        </div>
      </div>
      <dl class="grid gap-3 border-l-2 border-pine pl-4 text-[0.9375rem]">
        {
          profile.facts.map((f) => (
            <div class="flex flex-col-reverse">
              <dt class="text-muted">{f.label}</dt>
              <dd class="font-bold">{f.value}</dd>
            </div>
          ))
        }
        <div class="flex flex-col-reverse">
          <dt class="text-muted">{profile.location}</dt>
          <dd class="font-bold text-ochre">{profile.availability}</dd>
        </div>
      </dl>
    </div>

    <CareerGraph
      jobs={graphJobs}
      personal={projects.map((p) => ({ name: p.data.title, date: p.data.date }))}
      labels={{
        main: t('graph.main'),
        personal: t('graph.personal'),
        summary: t('graph.label', { summary }),
      }}
    />
  </div>
</section>
