---
import Section from '../ui/Section.astro';
import { getProfile } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { skills } = await getProfile(lang);
---

<Section id="skills" title={t('skills.title')} lede={t('skills.lede')}>
  <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((group) => (
        <div>
          <h3 class="mb-3 border-b-2 border-pine pb-2 font-bold">{group.category}</h3>
          <ul class="space-y-1.5 text-[0.9375rem]">
            {group.items.map((item) => (
              <li>
                {item.name}
                {item.selfTaught && (
                  <span class="ml-1.5 text-small whitespace-nowrap text-muted">
                    ({t('skills.selfTaught')})
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
