---
interface Props {
  id: string;
  title: string;
  lede?: string;
  alt?: boolean;
}

const { id, title, lede, alt = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={['gutter band', alt && 'border-y border-line bg-surface']}
>
  <div class="mx-auto max-w-page">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <h2 id={`${id}-title`} class="text-heading font-bold">{title}</h2>
      {lede && <p class="max-w-[56ch] text-muted">{lede}</p>}
    </div>
    <slot />
  </div>
</section>
