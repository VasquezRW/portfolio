---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Page not found · Wilmer Vasquez"
  description="This page does not exist."
>
  <section class="gutter band">
    <div class="mx-auto max-w-page">
      <h1 class="text-display font-extrabold">Page not found</h1>
      <p class="mt-3 text-lede text-muted">
        The page you are looking for does not exist. <a href="/">Go to the home page</a>.
      </p>
      <p class="mt-2 text-lede text-muted" lang="es">
        La página que buscas no existe. <a href="/es/">Ir al inicio</a>.
      </p>
    </div>
  </section>
</BaseLayout>
