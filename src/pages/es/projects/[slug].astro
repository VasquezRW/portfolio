---
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../components/pages/ProjectPage.astro';
import { getProjects, slugOf } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects('es');
  return projects.map((project) => ({ params: { slug: slugOf(project.id) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<ProjectPage project={project} lang="es" />
